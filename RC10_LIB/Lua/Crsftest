-- 状态记忆变量（用于边沿检测）
Last_control_mode = 0
Last_spear = 0

local function my_init()
    -- init 只需在模型加载时调用一次
end

local function my_background()
    -- background 周期性调用
end

local function my_run(event)
    lcd.clear() -- 清屏

    -- 获取自定义遥测数据（0x0C帧），添加 nil 防护
    local control_mode = getValue("0C40") or 0  -- 控制模式
    local robot_x = getValue("0C10") or 0       -- Robot X（uint16原始值）
    local robot_y = getValue("0C11") or 0       -- Robot Y（uint16原始值）
    local robot_yaw = getValue("0C12") or 0     -- Robot Yaw（uint16原始值）
    local kfs_1 = getValue("0C20") or 0         -- KFS数据1
    local kfs_2 = getValue("0C21") or 0         -- KFS数据2
    local spear = getValue("0C30") or 0         -- Spear状态

    -- 格式化字符串（直接显示原始数值）
    local x_str = string.format("%d", robot_x)
    local y_str = string.format("%d", robot_y)
    local yaw_str = string.format("%d", robot_yaw)
    local kfs1_str = string.format("%d", kfs_1)
    local kfs2_str = string.format("%d", kfs_2)
    local spear_str = string.format("%d", spear)

    -- 顶部显示控制模式
    if control_mode == 0 then
        lcd.drawText(0, 0, "Manual Mode", MIDSIZE)
    elseif control_mode == 1 then
        lcd.drawText(0, 0, "Auto Control", MIDSIZE)
    elseif control_mode == 2 then
        lcd.drawText(0, 0, "Semi Auto", MIDSIZE)
    elseif control_mode == 3 then
        lcd.drawText(0, 0, "Emergency", MIDSIZE + INVERS + BLINK)
    elseif control_mode == 4 then
        lcd.drawText(0, 0, "Debug Mode", MIDSIZE)
    elseif control_mode == 5 then
        lcd.drawText(0, 0, "Attack Move", MIDSIZE)
    else
        lcd.drawText(10, 0, "GDUT Robocon2025", MIDSIZE)
    end

    -- 显示 Robot 位姿数据（uint16原始值）
    lcd.drawText(0, 15, "R_X:" .. x_str .. "R_Y:" .. y_str .. "R_Yaw:" .. yaw_str, SMLSIZE)
    
    -- 显示 KFS 数据
    lcd.drawText(0, 25, "KFS1:" .. kfs1_str .. " KFS2:" .. kfs2_str, SMLSIZE)
    
    -- 显示 Spear 状态
    lcd.drawText(0, 35, "Spear:" .. spear_str, SMLSIZE)

    -- ========== 边沿检测与语音触发 ==========
    
    -- if Last_control_mode ~= 1 and control_mode == 1 then
    --     playFile("/SCRIPTS/TELEMETRY/cn/automode.wav")
    -- end
    -- if Last_control_mode ~= 3 and control_mode == 3 then
    --     playFile("/SCRIPTS/TELEMETRY/cn/emergency.wav")
    -- end
    -- if Last_control_mode ~= 5 and control_mode == 5 then
    --     playFile("/SCRIPTS/TELEMETRY/cn/attack.wav")
    -- end

    -- if Last_spear ~= 1 and spear == 1 then
    --     playFile("/SCRIPTS/TELEMETRY/cn/spearactive.wav")
    -- end

    -- 更新记忆变量
    Last_control_mode = control_mode
    Last_spear = spear

    return 0
end

return { run = my_run, background = my_background, init = my_init }