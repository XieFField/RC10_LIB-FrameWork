function h = draw_box(center, sizeXYZ, colorRGB, alpha)
% draw_box  函数功能：在三维空间中绘制一个长方体（立方体），并设置其颜色、透明度等外观属性  
% 输入参数说明：  
%   center    - 1×3 向量，代表长方体的几何中心坐标 [x, y, z]  
%   sizeXYZ   - 1×3 向量，代表长方体在 x/y/z 三个方向上的尺寸 [宽度, 深度, 高度]  
%   colorRGB  - 1×3 向量，代表长方体的 RGB 颜色（例如 [1,0,0] 表示红色）  
%   alpha     - 标量，代表长方体的透明度（0=完全透明，1=完全不透明）  
% 输出参数说明：  
%   h         - 返回 patch 对象的句柄，可用于后续修改该长方体的属性  

% -----------------------------
% 1. 解析几何中心与尺寸参数
% -----------------------------
x = center(1);  % 从 center 中提取 x 方向的中心坐标  
y = center(2);  % 从 center 中提取 y 方向的中心坐标  
z = center(3);  % 从 center 中提取 z 方向的中心坐标  

w = sizeXYZ(1); % 从 sizeXYZ 中提取 x 方向的长度（宽度）  
d = sizeXYZ(2); % 从 sizeXYZ 中提取 y 方向的长度（深度）  
hgt = sizeXYZ(3); % 从 sizeXYZ 中提取 z 方向的长度（高度）  

hx = w/2;   % 计算 x 方向上的半长（用于确定顶点在 x 方向的范围）  
hy = d/2;   % 计算 y 方向上的半长（用于确定顶点在 y 方向的范围）  
hz = hgt/2; % 计算 z 方向上的半长（用于确定顶点在 z 方向的范围）  

% -----------------------------
% 2. 计算长方体的 8 个顶点坐标
% -----------------------------
% V 是一个 3×8 的矩阵，每一列代表一个顶点的 [x, y, z] 坐标  
% 思路：对每个顶点，x/y/z 方向都在 [中心 - 半长, 中心 + 半长] 之间变化，组合出 8 种情况  
V = [x + [-hx, -hx,  hx,  hx, -hx, -hx,  hx,  hx]', ...  % x 坐标：8 个顶点的 x 分量  
     y + [-hy,  hy,  hy, -hy, -hy,  hy,  hy, -hy]', ...  % y 坐标：8 个顶点的 y 分量  
     z + [-hz, -hz, -hz, -hz,  hz,  hz,  hz,  hz]'];     % z 坐标：8 个顶点的 z 分量  

% -----------------------------
% 3. 定义长方体的面（Faces）索引
% -----------------------------
% F 是一个 M×4 的矩阵，每一行代表一个“四边形面”由哪 4 个顶点组成（顶点索引从 1 开始）  
F = [1,  2,  3,  4;   % 底面：由顶点 1、2、3、4 组成  
     5,  6,  7,  8;   % 顶面：由顶点 5、6、7、8 组成  
     1,  2,  6,  5;   % 侧面 1：由顶点 1、2、6、5 组成  
     2,  3,  7,  6;   % 侧面 2：由顶点 2、3、7、6 组成  
     3,  4,  8,  7;   % 侧面 3：由顶点 3、4、8、7 组成  
     4,  1,  5,  8];  % 侧面 4：由顶点 4、1、5、8 组成  

% -----------------------------
% 4. 调用 patch 函数绘制长方体
% -----------------------------
% patch 是 MATLAB 中用于绘制“补片”（多边形集合）的函数  
% 'Faces'  指定哪些顶点组成哪些面  
% 'Vertices' 指定所有顶点的坐标  
% 'FaceColor'  设置面的填充颜色  
% 'FaceAlpha'  设置面的透明度  
% 'EdgeColor'  设置边的颜色（这里设为深灰色 [0.2, 0.2, 0.2]）  
h = patch('Faces', F, 'Vertices', V, ...  
          'FaceColor', colorRGB, ...  
          'FaceAlpha', alpha, ...  
          'EdgeColor', [0.2, 0.2, 0.2]);  
end