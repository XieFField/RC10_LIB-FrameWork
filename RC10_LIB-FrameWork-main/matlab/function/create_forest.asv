+function [pillars, forest_rect] = create_forest(center, nx, ny, cell)
% 3×4 梅花林，固定高度分配：
% 20cm: 1,3,5,7,9,11
% 40cm: 2,4,10,12
% 60cm: 6,8
cx = center(1); cy = center(2);
W = nx*cell; H = ny*cell;

forest_rect.x = cx; forest_rect.y = cy;
forest_rect.w = W;  forest_rect.h = H;

col_20 = [0.7 1.0 0.7];  % 浅绿
col_40 = [0.2 0.8 0.2];  % 绿
col_60 = [0.0 0.5 0.0];  % 深绿

ids_20 = [1,3,5,7,9,11];
ids_40 = [2,4,10,12];
ids_60 = [6,8];

pillars = struct('id',{},'x',{},'y',{},'w',{},'d',{},'h',{},'patch',{});
k = 0;
for j = 1:ny            % 自下而上
    for i = 1:nx        % 自左向右
        k = k + 1;      % 编号：(j-1)*nx+i
        xc = cx - W/2 + (i-0.5)*cell;
        yc = cy - H/2 + (j-0.5)*cell;

        if ismember(k, ids_20), hgt = 0.20; col = col_20;
        elseif ismember(k, ids_40), hgt = 0.40; col = col_40;
        elseif ismember(k, ids_60), hgt = 0.60; col = col_60;
        else, error('未分配高度的桩编号: %d', k);
        end

        p = draw_box([xc,yc,hgt/2], [cell,cell,hgt], col, 0.6); % 方柱体
        pillars(k).id = k;
        pillars(k).x = xc; pillars(k).y = yc;
        pillars(k).w = cell; pillars(k).d = cell; pillars(k).h = hgt;
        pillars(k).patch = p;
        text(xc, yc, hgt+0.02, num2str(k), 'HorizontalAlignment','center', 'Color',[0 0 0]);
    end
end
end
